{
  "name": "artisanpack-ui/ecommerce-storefront-livewire",
  "description": "Livewire storefront for the ArtisanPack UI ecommerce engine.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "livewire",
    "ecommerce",
    "storefront",
    "checkout",
    "artisanpack-ui"
  ],
  "autoload": {
    "psr-4": {
      "ArtisanPackUI\\EcommerceStorefrontLivewire\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jacob Martella",
      "email": "me@jacobmartella.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-intl": "*",
    "illuminate/support": "^12.0|^13.0",
    "livewire/livewire": "^3.6|^4.0",
    "artisanpack-ui/ecommerce": "^1.1",
    "artisanpack-ui/livewire-ui-components": "^2.1",
    "artisanpack-ui/core": "^1.0",
    "artisanpack-ui/hooks": "^1.2",
    "artisanpack-ui/security": "^1.0.3|^2.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "pestphp/pest-plugin-livewire": "^4.0",
    "pestphp/pest-plugin-browser": "^4.0",
    "artisanpack-ui/code-style": "^1.1",
    "artisanpack-ui/code-style-pint": "^1.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "laravel/pint": "^1.26",
    "orchestra/testbench": "^10.2|^11.0",
    "friendsofphp/php-cs-fixer": "^3.75"
  },
  "conflict": {
    "artisanpack-ui/visual-editor": "<1.8"
  },
  "suggest": {
    "artisanpack-ui/visual-editor": "Commerce blocks (product grid, single product, add to cart, cart contents, checkout steps, and more) and editable product/category templates (^1.8).",
    "artisanpack-ui/media-library": "Responsive product, variant, and category images from the media library's conversions.",
    "artisanpack-ui/seo": "Meta tags and JSON-LD through the SEO package's schema collector (^1.4).",
    "artisanpack-ui/cms-framework": "Theme-aware visual-editor template resolution for storefront pages."
  },
  "scripts": {
    "lint": [
      "./vendor/bin/php-cs-fixer fix --dry-run --diff",
      "./vendor/bin/phpcs"
    ],
    "fix": "./vendor/bin/php-cs-fixer fix",
    "cs": "./vendor/bin/phpcs",
    "cs:fix": "./vendor/bin/phpcbf",
    "test": "./vendor/bin/pest --testsuite=Unit,Feature",
    "test:browser": [
      "npm run build:browser",
      "./vendor/bin/pest --group=browser"
    ]
  },
  "config": {
    "sort-packages": false,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ArtisanPackUI\\EcommerceStorefrontLivewire\\EcommerceStorefrontLivewireServiceProvider"
      ]
    }
  }
}
